SUPABASE_URL=https://xuvnqbojczuqgkqinzdp.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SECRET_KEY=your_jwt_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Wedy Visio — TURN relay. Without it two people on different networks (4G, company Wi-Fi...) often get « Connexion impossible ».
# Recommended (coturn with `use-auth-secret`, see DEPLOYMENT.md §4.1b): the API hands out credentials that expire after 12 h.
# VISIO_TURN_URL=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
# VISIO_TURN_SECRET=a_long_random_string
# Or a fixed login (any TURN provider):
# VISIO_TURN_USERNAME=wedy
# VISIO_TURN_CREDENTIAL=change_me
