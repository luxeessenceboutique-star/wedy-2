# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  Wedy backend — environment variables (copy to backend/.env, or set them in the platform)
#  Secrets: placeholders only here. Never commit real values.
#  REQUIRED = the app does not work without it · RECOMMENDED = a feature is off or degraded without it · OPTIONAL
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────────── REQUIRED
APP_ENV=production
# Long random string, stable across deploys (also signs the visio invite links: changing it invalidates them).  openssl rand -hex 32
SECRET_KEY=change_me_openssl_rand_hex_32
# Origins allowed to call the API (comma separated, no trailing slash)
ALLOWED_ORIGINS=https://wedy-front.tybotflow.com
# Public address of the site, used in share links and link previews (LinkedIn / Facebook / WhatsApp)
APP_PUBLIC_URL=https://wedy-front.tybotflow.com

# ── Supabase ────────────────────────────────────────────────────────────────────── REQUIRED
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
SUPABASE_SCHEMA=rh

# ── Login (Tybot is the identity provider; Wedy keeps the roles) ───────────────────── REQUIRED
TYBOT_API_URL=https://api.tybotflow.com/api/v1
# Lets the Users page list the Tybot accounts
TYBOTFLOW_API_KEY=<tybotflow api key>

# ── AI: Copilot, job-post texts and spelling fix, CV analysis ─────────────────────── RECOMMENDED
# Anthropic is used when present, otherwise the OpenAI-compatible router below
ANTHROPIC_API_KEY=<anthropic key>
OPENAI_API_KEY=<openai or router key>
OPENAI_BASE_URL=<router url, empty for api.openai.com>
OPENAI_MODEL=gpt-4o-mini
# Force the Copilot's provider / model (optional): anthropic | openai
# COPILOT_PROVIDER=
# COPILOT_MODEL=

# ── AI image of the job posts (Annonces → Diffuser → Image IA) ────────────────────── RECOMMENDED
# Same key / router as above unless the two *_IMAGE_API_KEY / *_IMAGE_BASE_URL lines are set
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=

# ── Files ───────────────────────────────────────────────────────────────────────── RECOMMENDED
# Employee files are kept on disk (a cache) AND in a private Supabase Storage bucket, so a redeploy loses nothing.
# Storage must be enabled in the Supabase project; the bucket is created automatically.
DURABLE_STORAGE=true
DURABLE_STORAGE_BUCKET=wedy-files
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=20
# Also mount a persistent volume on /app/uploads (docker-compose.yml already does: uploads_data)

# ── Wedy Visio: TURN relay (video calls between people on different networks) ──────── RECOMMENDED
# Without it two people on 4G / company Wi-Fi often get « Connexion impossible ». See DEPLOYMENT.md §4.1b.
# coturn with `use-auth-secret`: the API hands out credentials that expire after 12 h
VISIO_TURN_URL=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
VISIO_TURN_SECRET=change_me_long_random_string
# Or a fixed login from any TURN provider instead of VISIO_TURN_SECRET:
# VISIO_TURN_USERNAME=
# VISIO_TURN_CREDENTIAL=
# For the optional coturn container (docker compose --profile turn up -d coturn):
# VISIO_TURN_EXTERNAL_IP=<public IP of the server>
# VISIO_TURN_REALM=wedy

# ── Email (OPTIONAL) ─────────────────────────────────────────────────────────────────
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@tython.ma
# MAIL_FROM_NAME=WEDY RH
