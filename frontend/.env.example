# Wedy frontend — build-time variables (Vite). They are baked into the bundle at `npm run build`,
# so they must be set when the image / bundle is BUILT, not only when it runs.
# In production the API is reached on the same domain through the reverse proxy.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
